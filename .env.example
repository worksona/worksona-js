# Worksona.js Environment Variables Example
# Copy this file to .env and fill in your values for local development

# ============================================
# Railway API Configuration (for Netlify)
# ============================================
# These are automatically injected during Netlify build
# Set them in Netlify dashboard or via CLI:
#   netlify env:set RAILWAY_API_URL "https://your-app.railway.app"
#   netlify env:set RAILWAY_API_KEY "wsk_live_..." --secret

# Railway API Server URL
RAILWAY_API_URL=https://your-app.railway.app

# Railway API Authentication Key
RAILWAY_API_KEY=wsk_live_YOUR_KEY_HERE

# ============================================
# API Provider Keys (for worksona-server.js)
# ============================================
# Required for running the local API server

# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (optional)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google API Key (optional)
GOOGLE_API_KEY=your-google-api-key-here

# ============================================
# Server Configuration (for worksona-server.js)
# ============================================

# Port for local API server
PORT=3000

# Server API Key (for protecting endpoints)
# Format: wsk_live_ or wsk_test_
API_KEY=wsk_live_your-server-api-key-here

# Environment (development, production)
NODE_ENV=development

# Enable CORS
CORS_ENABLED=true

# Rate Limiting (requests per window)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000

# ============================================
# Notes
# ============================================
# 
# For Netlify Deployment:
# - Set RAILWAY_API_URL and RAILWAY_API_KEY in Netlify dashboard
# - Run: npm run netlify:setup (automated)
# - Or: netlify env:set RAILWAY_API_URL "..." --context production
# 
# For Local Development:
# - Copy this file to .env
# - Fill in your actual API keys
# - Run: npm start
# 
# Security:
# - Never commit .env to git (already in .gitignore)
# - Mark RAILWAY_API_KEY as secret in Netlify
# - Rotate keys regularly
# - Use different keys for prod/staging/dev
#
